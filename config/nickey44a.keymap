#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        left_p {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <14 15>;
        };

        l_d {
            bindings = <&kp LA(LC(D))>;
            key-positions = <24 25>;
        };

        c_d {
            bindings = <&kp LA(LC(F))>;
            key-positions = <25 26>;
        };

        r_d {
            bindings = <&kp LA(LC(G))>;
            key-positions = <26 27>;
        };

        f_d {
            bindings = <&kp LA(LC(ENTER))>;
            key-positions = <27 28>;
        };

        cap_1 {
            bindings = <&kp RS(RG(NUMBER_4))>;
            key-positions = <37 36>;
        };

        r_d2 {
            bindings = <&kp LA(LC(T))>;
            key-positions = <10 11>;
        };

        system {
            bindings = <&to 3>;
            key-positions = <38 39 40>;
        };

        right_p {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <15 16>;
        };

        /* Y + H + N + Right Alt: right half enters the bootloader. */
        boot_right {
            bindings = <&boot_right>;
            key-positions = <7 19 33 43>;
            timeout-ms = <80>;
        };

        /* T + G + B + Left Ctrl: left half enters the bootloader. */
        boot_left_combo {
            bindings = <&boot_left>;
            key-positions = <4 16 28 38>;
            timeout-ms = <80>;
        };
    };

    macros {
        touch_on: touch_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&touch_feedback 1 &to 0>;
        };
        touch_off: touch_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&touch_feedback 0 &to 0>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mission: mission {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(UP_ARROW)>;
            label = "MISSION";
        };

        launch: launch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(L)>;
            label = "LAUNCH";
        };
    };

    behaviors {
        touch_feedback: touch_feedback {
            compatible = "zmk,behavior-touch-feedback";
            #binding-cells = <1>;
            display-name = "Touch feedback (0 off / 1 on)";
        };

        /*
         * Combos always run on the central (the nemu-link dongle), so a plain
         * &bootloader would reset the dongle. These send it to a half
         * instead (index = CONFIG_ZMK_NEMU_LINK_PERIPHERAL_ID: left 0,
         * right 1); that half must be connected. The dongle itself enters
         * its bootloader by holding its button while plugging it in.
         */
        boot_left: boot_left {
            compatible = "zmk,behavior-peripheral-invoke";
            #binding-cells = <0>;
            bindings = <&bootloader>;
            peripheral = <0>;
            display-name = "Bootloader (left)";
        };

        boot_right: boot_right {
            compatible = "zmk,behavior-peripheral-invoke";
            #binding-cells = <0>;
            bindings = <&bootloader>;
            peripheral = <1>;
            display-name = "Bootloader (right)";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W  &kp E  &kp R  &kp T      &trans                                                    &trans       &kp Y          &kp U  &kp I                &kp O                    &kp P
&kp A        &kp S  &kp D  &kp F  &kp G      &trans                                                    &trans       &kp H          &kp J  &kp K                &kp L                    &mt EQUAL MINUS
&mt LSHFT Z  &kp X  &kp C  &kp V  &kp B      &trans       &trans           &trans                      &trans       &kp N          &kp M  &mt SEMICOLON COMMA  &mt SINGLE_QUOTE PERIOD  &mt RIGHT_SHIFT SLASH
                                  &kp LCTRL  &lt 2 SPACE  &kp BACKSPACE    &mt RIGHT_COMMAND CAPSLOCK  &lt 1 ENTER  &kp RIGHT_ALT
            >;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5   &trans                    &trans  &kp NUMBER_6     &kp N7         &kp N8        &kp N9      &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5   &trans                    &trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR  &kp PERCENT
&kp F6        &kp F7        &kp F8        &kp F9        &kp F10  &trans  &trans    &trans  &trans  &kp RIGHT_ALT    &kp AMPERSAND  &kp ASTERISK  &kp TILDE   &kp PIPE
                                                        &trans   &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp PG_UP      &kp HOME        &kp UP_ARROW  &kp END    &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans          &trans        &trans     &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&none           &none         &none         &none         &none         &none                           &trans  &trans  &trans  &trans  &trans  &trans
&none           &trans        &trans        &trans        &trans        &trans                          &trans  &touch_on  &touch_off  &trans  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                          &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };

        drag_layer {
            display-name = "Drag";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
