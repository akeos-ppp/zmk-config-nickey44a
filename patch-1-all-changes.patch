+        .swipe_initial_time = DT_INST_PROP_OR(inst, swipe_initial_time, -1),                         \
+        .swipe_angle = DT_INST_PROP_OR(inst, swipe_angle, -1),                                       \
+        .swipe_consecutive_distance = DT_INST_PROP_OR(inst, swipe_consecutive_distance, -1),         \
