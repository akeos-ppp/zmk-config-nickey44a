+#define TPS43_SWITCH_XY_AXIS        BIT(2)      /* Swap X and Y axes */
+
+
+/* ============================================================ */
+/* Gesture events 0 (0x000D) - 8 bits */
+/* ============================================================ */
+
+#define TPS43_SINGLE_TAP            BIT(0)      /* Single finger tap detected */
+#define TPS43_PRESS_AND_HOLD        BIT(1)      /* Press and hold detected */
