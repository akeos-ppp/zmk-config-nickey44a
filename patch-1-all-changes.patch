diff --git a/boards/shields/nickey44a/dts/bindings/input/processor/input-processor-three-finger-swipe.yaml b/boards/shields/nickey44a/dts/bindings/input/processor/input-processor-three-finger-swipe.yaml
new file mode 100644
index 0000000..dcda963
--- /dev/null
+++ b/boards/shields/nickey44a/dts/bindings/input/processor/input-processor-three-finger-swipe.yaml
@@ -0,0 +1,41 @@
+description: One four-way three-finger swipe per complete touch, with configurable ZMK keycodes
+compatible: "zmk,input-processor-three-finger-swipe"
+include: ip_zero_param.yaml
+properties:
+  touch-code:
+    type: int
+    required: true
+  left-code:
+    type: int
+    required: true
+    description: Input key code the driver reports for one physically leftward sample.
+  right-code:
+    type: int
+    required: true
+  up-code:
+    type: int
+    required: true
+  down-code:
+    type: int
+    required: true
+  threshold:
+    type: int
+    default: 3
+    description: Positive minimum net same-axis samples before firing.
+  axis-ratio:
+    type: int
+    default: 2
+    description: Positive ratio of net samples to the other axis's total samples.
+  left-keycode:
+    type: int
+    required: true
+    description: Encoded ZMK keycode tapped on a leftward swipe.
+  right-keycode:
+    type: int
+    required: true
+  up-keycode:
+    type: int
+    required: true
+  down-keycode:
+    type: int
+    required: true
diff --git a/boards/shields/nickey44a/nickey44a_r.overlay b/boards/shields/nickey44a/nickey44a_r.overlay
index 54c31ed..f8bbb55 100644
--- a/boards/shields/nickey44a/nickey44a_r.overlay
+++ b/boards/shields/nickey44a/nickey44a_r.overlay
@@ -70,6 +70,29 @@
         right-keycode = <C_AC_FORWARD>;
     };
 
+    /*
+     * Three-finger swipes (macOS): up/down = Mission Control, left/right =
+     * adjacent Space, following the trackpad convention (fingers left -> the
+     * Space to the right). The driver reports controller coordinates; with
+     * the measured orientation above, controller SOUTH = physical left,
+     * NORTH = right, EAST = up, WEST = down.
+     */
+    tps43_three_finger_swipe: tps43_three_finger_swipe {
+        compatible = "zmk,input-processor-three-finger-swipe";
+        #input-processor-cells = <0>;
+        touch-code = <INPUT_BTN_TOUCH>;
+        left-code = <INPUT_BTN_SOUTH>;
+        right-code = <INPUT_BTN_NORTH>;
+        up-code = <INPUT_BTN_EAST>;
+        down-code = <INPUT_BTN_WEST>;
+        threshold = <3>;
+        axis-ratio = <2>;
+        left-keycode = <LC(RIGHT)>;
+        right-keycode = <LC(LEFT)>;
+        up-keycode = <LC(UP)>;
+        down-keycode = <LC(UP)>;
+    };
+
     tps43_touch_inertia: tps43_touch_inertia {
         compatible = "zmk,input-processor-touch-inertia";
         #input-processor-cells = <0>;
@@ -90,7 +113,8 @@
         input-processors = <&tps43_orientation (INPUT_TRANSFORM_XY_SWAP |
                                              INPUT_TRANSFORM_X_INVERT |
                                              INPUT_TRANSFORM_Y_INVERT)>,
-                           <&tps43_touch_swipe>, <&tps43_touch_inertia>;
+                           <&tps43_three_finger_swipe>, <&tps43_touch_swipe>,
+                           <&tps43_touch_inertia>;
 
         snipe_layer {
             layers = <1>;
@@ -119,6 +143,9 @@
         single-tap;
         two-finger-tap;
         scroll;
+        /* One driver event per three-finger sample; the processor fires once per touch. */
+        three-finger-swipe;
+        three-finger-swipe-throttle-ms = <0>;
         /* The listener swaps axes, so driver X controls host vertical scrolling. */
         invert-scroll-y;
 
