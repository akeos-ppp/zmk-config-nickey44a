#include "nickey44a.dtsi"
#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * TPS43 FPC breakout wiring:
 *   SCL = XIAO D5/P0.05, SDA = XIAO D4/P0.04, RDY = XIAO D3/P0.29.
 * NRST is held high in hardware and is not controlled by the MCU.
 */

&pinctrl {
    nickey44a_tps43_i2c0_default: nickey44a_tps43_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    nickey44a_tps43_i2c0_sleep: nickey44a_tps43_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

/ {
    tps43_scroll_inertia: tps43_scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;

        /* IQS5xx emits integer wheel steps after its unchanged /32 scaling. */
        axis = <0>;
        gain = <400>;
        blend = <600>;
        start = <1>;
        move = <6>;
        min-events = <3>;
        release = <40>;
        gesture-timeout = <120>;
        decay-fast = <990>;
        decay-slow = <990>;
        decay-tail = <990>;
        friction = <35>;
        stop = <1>;
        limit = <12>;
        span = <1500>;
        tick = <8>;
        scale = <1000>;
        scale-div = <1000>;
    };

    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43>;
        input-processors = <&tps43_scroll_inertia>;
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&nickey44a_tps43_i2c0_default>;
    pinctrl-1 = <&nickey44a_tps43_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    #address-cells = <1>;
    #size-cells = <0>;

    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        rdy-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;

        one-finger-tap;
        two-finger-tap;
        press-and-hold;
        scroll;
        natural-scroll-x;
        natural-scroll-y;

        bottom-beta = <5>;
        stationary-threshold = <5>;
        /* Touch side up, TPS43 notch on the right: rotate axes for vertical use. */
        switch-xy;
        flip-x;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        /* D3/D4/D5 are reserved for TPS43 RDY/SDA/SCL during bring-up. */
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            ;
};
