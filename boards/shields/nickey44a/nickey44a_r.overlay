#include "nickey44a.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * TPS43 FPC breakout wiring:
 *   SDA = XIAO NFC1/P0.09
 *   SCL = XIAO NFC2/P0.10
 *   RDY = XIAO P1.10
 *   NRST = XIAO P1.00
 */

&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    nickey44a_tps43_i2c0_default: nickey44a_tps43_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
        };
    };

    nickey44a_tps43_i2c0_sleep: nickey44a_tps43_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
            low-power-enable;
        };
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        left_tps43_split: left_tps43_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /*
     * Left pad: one-finger circular motion changes the volume (clockwise =
     * up, 45 degrees per step). If the direction feels reversed on hardware,
     * swap the two keycodes.
     */
    left_circle_volume: left_circle_volume {
        compatible = "zmk,input-processor-circle-keys";
        #input-processor-cells = <0>;
        x-code = <INPUT_REL_X>;
        y-code = <INPUT_REL_Y>;
        touch-code = <INPUT_BTN_TOUCH>;
        segment-distance = <12>;
        step-degrees = <45>;
        max-turn-degrees = <90>;
        idle-reset-ms = <200>;
        clockwise-keycode = <C_VOL_UP>;
        counterclockwise-keycode = <C_VOL_DN>;
    };

    /*
     * Left pad: one Back/Forward per two-finger left/right swipe, and one
     * browser tab switch per two-finger up/down swipe (Ctrl+Tab = next tab,
     * Ctrl+Shift+Tab = previous tab). If a direction is reversed on hardware,
     * swap that pair of keycodes.
     */
    left_touch_swipe: left_touch_swipe {
        compatible = "zmk,input-processor-touch-swipe";
        #input-processor-cells = <0>;
        hwheel-code = <INPUT_REL_HWHEEL>;
        wheel-code = <INPUT_REL_WHEEL>;
        touch-code = <INPUT_BTN_TOUCH>;
        threshold = <8>;
        axis-ratio = <2>;
        left-keycode = <C_AC_BACK>;
        right-keycode = <C_AC_FORWARD>;
        up-keycode = <LC(LS(TAB))>;
        down-keycode = <LC(TAB)>;
    };

    /* Left pad: vertical two-finger motion only switches tabs, never scrolls. */
    left_wheel_blocker: left_wheel_blocker {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL>;
    };

    left_tps43_listener: left_tps43_listener {
        compatible = "zmk,input-listener";
        device = <&left_tps43_split>;
        /*
         * Observe the circle, turn HWHEEL into Back/Forward (touch-swipe always
         * consumes HWHEEL) and WHEEL into tab switching, then zero WHEEL and X/Y.
         */
        input-processors = <&left_circle_volume>, <&left_touch_swipe>,
                           <&left_wheel_blocker 0 1>, <&zip_xy_scaler 0 1>;
    };

    tps43_orientation: tps43_orientation {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X INPUT_REL_HWHEEL>;
        y-codes = <INPUT_REL_Y INPUT_REL_WHEEL>;
    };


    /*
     * Three-finger gestures (macOS): tap = Launchpad, up/down = Mission Control, left/right =
     * adjacent Space, following the trackpad convention (fingers left -> the
     * Space to the right). The driver reports controller coordinates; with
     * the measured orientation above, controller SOUTH = physical left,
     * NORTH = right, EAST = up, WEST = down.
     */
    tps43_three_finger_swipe: tps43_three_finger_swipe {
        compatible = "zmk,input-processor-three-finger-swipe";
        #input-processor-cells = <0>;
        touch-code = <INPUT_BTN_TOUCH>;
        left-code = <INPUT_BTN_SOUTH>;
        right-code = <INPUT_BTN_NORTH>;
        up-code = <INPUT_BTN_EAST>;
        down-code = <INPUT_BTN_WEST>;
        threshold = <3>;
        axis-ratio = <2>;
        left-keycode = <LC(RIGHT)>;
        right-keycode = <LC(LEFT)>;
        up-keycode = <LC(UP)>;
        down-keycode = <LC(UP)>;
        /* Driver-local three-finger contact code (TPS43_BTN_THREE_FINGERS). */
        three-finger-code = <0x14e>;
        /* Three-finger tap = Launchpad; same shortcut as the keymap's LAUNCH macro. */
        tap-keycode = <LG(L)>;
        tap-max-ms = <300>;
        tap-max-samples = <2>;
        click-suppress-ms = <150>;
    };

    tps43_touch_inertia: tps43_touch_inertia {
        compatible = "zmk,input-processor-touch-inertia";
        #input-processor-cells = <0>;
        wheel-code = <INPUT_REL_WHEEL>;
        touch-code = <INPUT_BTN_TOUCH>;
        tick-ms = <10>;
        decay-permille = <920>;
        stop-threshold-q8 = <96>;
        launch-threshold-q8 = <384>;
        ema-new-permille = <250>;
        cancel-scroll-inertia-on-ctrl;
    };

    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43>;
        /* Correct the measured controller output: left -> down, down -> left. */
        input-processors = <&tps43_orientation (INPUT_TRANSFORM_XY_SWAP |
                                             INPUT_TRANSFORM_X_INVERT |
                                             INPUT_TRANSFORM_Y_INVERT)>,
                           <&tps43_three_finger_swipe>, <&tps43_touch_inertia>;

        snipe_layer {
            layers = <1>;
            process-next;
            input-processors = <&zip_xy_scaler 2 3>;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&nickey44a_tps43_i2c0_default>;
    pinctrl-1 = <&nickey44a_tps43_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    #address-cells = <1>;
    #size-cells = <0>;

    tps43: tps43@74 {
        compatible = "azoteq,tps43";
        reg = <0x74>;
        rst-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
        rdy-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;

        single-tap;
        /*
         * Touch and stay still for hold-time to press the left button and drag.
         * drag-lock keeps it pressed after lift; the next single tap releases.
         */
        press-and-hold;
        drag-lock;
        two-finger-tap;
        scroll;
        /* One driver event per three-finger sample; the processor fires once per touch. */
        three-finger-swipe;
        three-finger-swipe-throttle-ms = <0>;
        /* The listener swaps axes, so driver X controls host vertical scrolling. */
        invert-scroll-y;

        filter-settings = <0x0B>;
        filter-dynamic-bottom = <5>;
        sensitivity = <100>;
        scroll-sensitivity = <5>;
        hold-time = <250>;
        enable-power-management;
        /* Controller settings used when the listener's correction was measured. */
        switch-xy;
        invert-x;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};
