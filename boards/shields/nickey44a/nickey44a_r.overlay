#include "nickey44a.dtsi"
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * TPS43 FPC breakout wiring:
 *   SDA = XIAO NFC1/P0.09, SCL = XIAO NFC2/P0.10,
 *   RDY = XIAO hidden pad P0.16 (PDM_DATA; not free on Sense boards).
 * NRST is held high in hardware and is not controlled by the MCU.
 */

&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    nickey44a_tps43_i2c0_default: nickey44a_tps43_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
        };
    };

    nickey44a_tps43_i2c0_sleep: nickey44a_tps43_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
            low-power-enable;
        };
    };
};

/ {
    tps43_orientation: tps43_orientation {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X INPUT_REL_HWHEEL>;
        y-codes = <INPUT_REL_Y INPUT_REL_WHEEL>;
    };

    tps43_scroll_inertia: tps43_scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;

        /* IQS5xx emits integer wheel steps after its unchanged /32 scaling. */
        axis = <0>;
        gain = <400>;
        blend = <600>;
        start = <1>;
        move = <6>;
        min-events = <3>;
        release = <40>;
        gesture-timeout = <120>;
        decay-fast = <990>;
        decay-slow = <990>;
        decay-tail = <990>;
        friction = <35>;
        stop = <1>;
        limit = <12>;
        span = <1500>;
        tick = <8>;
        scale = <1000>;
        scale-div = <1000>;
    };

    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43>;
        /* Correct the measured controller output: left -> down, down -> left. */
        input-processors = <&tps43_orientation (INPUT_TRANSFORM_XY_SWAP |
                                             INPUT_TRANSFORM_X_INVERT |
                                             INPUT_TRANSFORM_Y_INVERT)>,
                           <&tps43_scroll_inertia>;
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&nickey44a_tps43_i2c0_default>;
    pinctrl-1 = <&nickey44a_tps43_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    #address-cells = <1>;
    #size-cells = <0>;

    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        rdy-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;

        one-finger-tap;
        two-finger-tap;
        press-and-hold;
        scroll;
        natural-scroll-x;
        natural-scroll-y;

        bottom-beta = <5>;
        stationary-threshold = <5>;
        /* Controller settings used when the listener's correction was measured. */
        switch-xy;
        flip-x;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};
