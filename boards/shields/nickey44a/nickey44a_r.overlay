#include "nickey44a.dtsi"
#include <behaviors.dtsi>
#include <scroll-snap.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Right pad: LalaPad Gen2 trackpad (Azoteq IQS9151, I2C 0x56) on the former
 * TPS43 FPC breakout wiring:
 *   SDA  = XIAO NFC1/P0.09
 *   SCL  = XIAO NFC2/P0.10
 *   RDY  = XIAO P1.10 (IQS9151 RDY, active low)
 *   NRST = XIAO P1.00 (held high; leave unconnected if the module has none)
 * The left pad is also an IQS9151 (see nickey44a_l.overlay).
 */

&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    nickey44a_iqs9151_i2c0_default: nickey44a_iqs9151_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
        };
    };

    nickey44a_iqs9151_i2c0_sleep: nickey44a_iqs9151_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
            low-power-enable;
        };
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        left_pad_split: left_pad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /*
     * Left pad: one-finger circular motion changes the volume (clockwise =
     * up, 45 degrees per step). If the direction feels reversed on hardware,
     * swap the two keycodes.
     */
    left_circle_volume: left_circle_volume {
        compatible = "zmk,input-processor-circle-keys";
        #input-processor-cells = <0>;
        x-code = <INPUT_REL_X>;
        y-code = <INPUT_REL_Y>;
        /* IQS9151 has no TOUCH event; idle-reset-ms delimits strokes. */
        touch-code = <INPUT_BTN_TOUCH>;
        /* Tuned for IQS9151 raw counts; raise if jitter fires steps. */
        segment-distance = <40>;
        step-degrees = <45>;
        max-turn-degrees = <90>;
        idle-reset-ms = <200>;
        clockwise-keycode = <C_VOL_UP>;
        counterclockwise-keycode = <C_VOL_DN>;
    };

    /*
     * Left pad (IQS9151): one browser tab switch per two-finger up/down
     * swipe (Ctrl+Tab = next tab, Ctrl+Shift+Tab = previous tab). The
     * IQS9151 has no TOUCH event, so a WHEEL gap of idle-reset-ms starts a
     * new swipe. Horizontal Back/Forward comes from the driver's one-shot
     * 2F swipe (BTN_8/BTN_9) instead, since SCROLL_X is off on the left.
     * If the vertical direction is reversed on hardware, swap the keycodes.
     */
    left_touch_swipe: left_touch_swipe {
        compatible = "zmk,input-processor-touch-swipe";
        #input-processor-cells = <0>;
        hwheel-code = <INPUT_REL_HWHEEL>;
        wheel-code = <INPUT_REL_WHEEL>;
        idle-reset-ms = <150>;
        /* Raw IQS9151 centroid counts after the 50-count scroll start. */
        threshold = <150>;
        vertical-threshold = <150>;
        axis-ratio = <2>;
        left-keycode = <C_AC_BACK>;
        right-keycode = <C_AC_FORWARD>;
        up-keycode = <LC(LS(TAB))>;
        down-keycode = <LC(TAB)>;
    };

    /* Left pad: vertical two-finger motion only switches tabs, never scrolls. */
    left_wheel_blocker: left_wheel_blocker {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL>;
    };

    /*
     * Left pad gesture keys from the IQS9151 driver:
     *   BTN_0 1F tap         -> left click
     *   BTN_1 2F tap         -> middle click
     *   BTN_8 / BTN_9 2F swipe right / left -> Forward / Back
     *   BTN_2..BTN_7 (3F, pinch) are disabled in nickey44a_l.conf and
     *   swallowed here so they never click.
     * If Back/Forward is reversed on hardware, swap the BTN_8/BTN_9 bindings.
     */
    left_iqs9151_key_behaviors: left_iqs9151_key_behaviors {
        compatible = "zmk,input-processor-behaviors-consume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <INPUT_BTN_0 INPUT_BTN_1 INPUT_BTN_2 INPUT_BTN_3 INPUT_BTN_4
                 INPUT_BTN_5 INPUT_BTN_6 INPUT_BTN_7 INPUT_BTN_8 INPUT_BTN_9>;
        bindings = <&mkp LCLK>, <&mkp MCLK>, <&none>, <&none>, <&none>,
                   <&none>, <&none>, <&none>, <&kp C_AC_FORWARD>, <&kp C_AC_BACK>;
    };

    left_pad_listener: left_pad_listener {
        compatible = "zmk,input-listener";
        device = <&left_pad_split>;
        /*
         * Map gesture keys, observe the circle (volume), turn WHEEL into tab
         * switching, then zero WHEEL and X/Y: the left pad never moves the
         * cursor or scrolls.
         */
        input-processors = <&left_iqs9151_key_behaviors>, <&left_circle_volume>,
                           <&left_touch_swipe>, <&left_wheel_blocker 0 1>,
                           <&zip_xy_scaler 0 1>;
    };

    /*
     * Right pad: LalaPad Gen2 IQS9151 (same gesture mapping as LalaPad Gen2's
     * Mac layer, right side). The driver reports gestures as INPUT_BTN_x key
     * events; they are bound directly to behaviors here instead of
     * LalaPad's virtual key positions (&tp_to_pos).
     *   BTN_0 1F tap / hold       -> left click (drag)
     *   BTN_1 2F tap              -> right click
     *   BTN_2 3F tap              -> Launchpad (LG(L), same as &launch)
     *   BTN_3 / BTN_4 3F swipe L/R -> mouse back / forward (MB4 / MB5)
     *   BTN_5 / BTN_6 3F swipe U/D -> Mission Control (LC(UP), same as &mission)
     *   BTN_7 2F pinch            -> MB5 held + wheel
     */
    iqs9151_key_behaviors: iqs9151_key_behaviors {
        compatible = "zmk,input-processor-behaviors-consume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <INPUT_BTN_0 INPUT_BTN_1 INPUT_BTN_2 INPUT_BTN_3
                 INPUT_BTN_4 INPUT_BTN_5 INPUT_BTN_6 INPUT_BTN_7>;
        bindings = <&mkp LCLK>, <&mkp RCLK>, <&kp LG(L)>, <&mkp MB4>,
                   <&mkp MB5>, <&kp LC(UP_ARROW)>, <&kp LC(UP_ARROW)>, <&mkp MB5>;
    };

    iqs9151_listener: iqs9151_listener {
        compatible = "zmk,input-listener";
        device = <&iqs9151>;
        input-processors = <&iqs9151_key_behaviors>,
                           <&zip_xy_scaler 1 4>,
                           <&zip_scroll_scaler 1 12>,
                           <&zip_scroll_snap>;

        snipe_layer {
            layers = <1>;
            input-processors = <&iqs9151_key_behaviors>,
                               <&zip_xy_scaler 1 12>,
                               <&zip_scroll_scaler 1 40>,
                               <&zip_scroll_snap>;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&nickey44a_iqs9151_i2c0_default>;
    pinctrl-1 = <&nickey44a_iqs9151_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    #address-cells = <1>;
    #size-cells = <0>;

    iqs9151: iqs9151@56 {
        compatible = "azoteq,iqs9151";
        reg = <0x56>;
        status = "okay";
        /* IQS9151 RDY on the former TPS43 RDY line (P1.10). */
        irq-gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

/*
 * The former TPS43 NRST line (P1.00) is driven high so an IQS9151 module
 * with NRST wired to it is never held in reset.
 */
&gpio1 {
    iqs9151_nrst_hog {
        gpio-hog;
        gpios = <0 GPIO_ACTIVE_HIGH>;
        output-high;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};
