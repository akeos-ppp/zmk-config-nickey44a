# nemu-link: both halves are 2.4GHz peripherals; the nemu-link dongle is
# the split central.
if SHIELD_NICKEY44A_R || SHIELD_NICKEY44A_L

config ZMK_KEYBOARD_NAME
    default "Nickey44A-PAD"

config ZMK_SPLIT
    default y

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 30

config RGBLED_WIDGET_BATTERY_LEVEL_CRITICAL
    default 10

endif
