if SHIELD_NICKEY44A_R

config ZMK_KEYBOARD_NAME
    default "nickey44a-ps"

config ZMK_BLE
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_NICKEY44A_R || SHIELD_NICKEY44A_L

